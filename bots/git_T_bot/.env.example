# Never paste this token into Discord, Git, or a Codex chat.
DISCORD_BOT_TOKEN=

# Your Discord server (guild) ID.
DISCORD_GUILD_ID=

# Create a private `codex-admin` text channel and paste its channel ID here.
DISCORD_ADMIN_CHANNEL_ID=

# Create/assign a `Codex Operator` role and paste its role ID here.
DISCORD_ALLOWED_ROLE_IDS=

# Existing role channels
DISCORD_QA_PM_CHANNEL_ID=
DISCORD_LEAD_CHANNEL_ID=
DISCORD_PROGRAMMER_CHANNEL_ID=
DISCORD_PLANNER_CHANNEL_ID=
DISCORD_ART_CHANNEL_ID=

# Existing Codex session IDs
CODEX_QA_PM_SESSION_ID=
CODEX_LEAD_SESSION_ID=
CODEX_PROGRAMMER_SESSION_ID=
CODEX_PLANNER_SESSION_ID=
CODEX_ART_SESSION_ID=

# Optional labels for shared GitHub repositories or multiple bot instances.
# Defaults: repository label = git origin or workspace folder name, branch label = current git branch.
CODEX_REPOSITORY_LABEL=
CODEX_BRANCH_LABEL=
CODEX_THREAD_PREFIX=
CODEX_WORKSPACE_DISPLAY_NAME=
CODEX_INSTANCE_SLUG=
CODEX_COMPUTER_ID=
CODEX_COMPUTER_DISPLAY_NAME=

# Optional task-completion alert routing. Format:
# source_channel_id:destination_channel_id,source_channel_id:destination_channel_id
DISCORD_COMPLETION_ALERT_ROUTES=

CODEX_HOME=C:\Users\<YourUser>\.codex
CODEX_WORKSPACE_ROOT=C:\path\to\git_T_bot
CODEX_TIMEOUT_MS=900000
