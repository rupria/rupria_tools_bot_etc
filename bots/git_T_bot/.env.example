# Never paste this token into GitHub or Discord chat.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_CHANNEL_ID=
# Optional comma-separated role ids allowed to manage watches.
DISCORD_ALLOWED_ROLE_IDS=

# Optional. Used only by commands that query GitHub, such as /github_branches.
GITHUB_TOKEN=

# Required for webhook signature verification. Use a long random value.
GITHUB_WEBHOOK_MASTER_SECRET=

# Public HTTPS origin of this service, without the webhook path.
GITHUB_WEBHOOK_PUBLIC_URL=https://your-service.example.com
GITHUB_WEBHOOK_PATH=/webhooks/github
WEBHOOK_HOST=0.0.0.0
# Hosting platforms normally provide PORT automatically.
WEBHOOK_PORT=8080

# Optional fixed watches. Format:
# owner/repo|branch|channel_id,owner/repo|branch|channel_id
WATCH_TARGETS=

# Optional command behavior. The default command becomes `!watch ...`.
COMMAND_PREFIX=!
STARTUP_NOTIFY=true
