# Never paste this token into GitHub or Discord chat.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_CHANNEL_ID=
# Optional comma-separated role ids allowed to manage watches.
DISCORD_ALLOWED_ROLE_IDS=

# Required for authenticated 20-second polling.
GITHUB_TOKEN=

# Dishost free plan uses polling because it has no public inbound URL.
POLLING_ENABLED=true
# Poll interval in milliseconds, used only when POLLING_ENABLED=true.
WATCH_POLL_INTERVAL_MS=20000

# Optional fixed watches. Format:
# owner/repo|branch|channel_id,owner/repo|branch|channel_id
WATCH_TARGETS=

# Optional legacy text-command behavior.
COMMAND_PREFIX=!
STARTUP_NOTIFY=true
