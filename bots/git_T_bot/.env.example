# Never paste this token into GitHub or Discord chat.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_CHANNEL_ID=
# Optional comma-separated role ids allowed to manage watches.
DISCORD_ALLOWED_ROLE_IDS=

# Optional GitHub token. Strongly recommended if you poll often or watch private repos.
GITHUB_TOKEN=

# Poll interval in milliseconds. Keep 60000 or higher in most cases.
WATCH_POLL_INTERVAL_MS=60000

# Optional fixed watches. Format:
# owner/repo|branch|channel_id,owner/repo|branch|channel_id
WATCH_TARGETS=

# Optional command behavior. The default command becomes `!watch ...`.
COMMAND_PREFIX=!
STARTUP_NOTIFY=true
